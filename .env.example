# PostgreSQL
POSTGRES_DB=mos
POSTGRES_USER=mos
POSTGRES_PASSWORD=change-me-strong-password

# Backend
SPRING_PROFILES_ACTIVE=prod,dev
JWT_SECRET=change-me-use-long-random-string-at-least-32-characters
BACKEND_PORT=8080

# Frontend (internal nginx port, not published directly)
FRONTEND_PORT=80

# Public entry point (nginx reverse proxy)
NGINX_PORT=80

# CORS — set to the URL users open in the browser (no wildcards)
# Examples: http://localhost  or  http://192.168.1.105
MOS_CORS_ALLOWED_ORIGINS=http://172.23.80.1

# Demo seed (requires dev profile in SPRING_PROFILES_ACTIVE)
MOS_DEMO_SEED_ENABLED=true

# QR code URL embedded in generated images (use LAN IP for phone scanning)
# Example: http://192.168.1.105/qr
MOS_QR_BASE_URL=https://mos.local/qr
